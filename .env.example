# Environment variables — copy to `.env` and fill in real values.
# `.env` is git-ignored; never commit real secrets.

# --- Competitions needs API ---
# Key used by scripts/fetch_new_features.py to read the Webcup needs.
WEBCUP_API_KEY=

# --- Database (PostgreSQL) ---
# docker-compose runs PostgreSQL and builds its own URL from these values.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nova_terra
# Used by the app when running locally (`npm run dev`) against the Docker DB.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nova_terra?schema=public"
# Hosted PostgreSQL (Neon/Supabase):
# DATABASE_URL="postgresql://user:password@host:5432/nova_terra?sslmode=require"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL="http://localhost:3000"
