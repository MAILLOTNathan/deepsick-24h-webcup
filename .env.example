# Environment variables — copy to `.env` and fill in real values.
# `.env` is git-ignored; never commit real secrets.

# --- Competitions needs API ---
# Key used by scripts/fetch_new_features.py to read the Webcup needs.
WEBCUP_API_KEY=

# --- Database (Prisma) ---
# SQLite for local dev:
DATABASE_URL="file:./dev.db"
# PostgreSQL in production, e.g. Neon/Supabase:
# DATABASE_URL="postgresql://user:password@host:5432/nova_terra?sslmode=require"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL="http://localhost:3000"
